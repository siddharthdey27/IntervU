# ---- Supabase Postgres (Project Settings -> Database -> Connection string) ----
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-supabase-db-password

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-string-min-32-bytes

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- AI providers ----
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=

# ---- AWS S3 (resume storage) ----
AWS_S3_BUCKET=prep-pilot-resumes
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
